model Language {
  id        String             @id @default(uuid())
  name      String
  code      String             @unique
  status    LanguageStatus
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  questions QuestionLanguage[]
  runtimes  SandboxRuntime[]
}

enum LanguageStatus {
  ACTIVE
  INACTIVE
}
