model Tag {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  status      TagStatus
  createdBy   String
  updatedBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  questions   QuestionTag[]

  @@index([status])
}

enum TagStatus {
  ACTIVE
  INACTIVE
}
