model Question {
  id           String                @id @default(uuid())
  categoryId   String?
  title        String
  description  String
  questionType QuestionType
  difficulty   Difficulty
  status       QuestionStatus
  createdBy    String
  updatedBy    String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  constraints  String?
  codingConfig CodingQuestionConfig?
  mcqConfig    MCQConfig?
  category     Category?             @relation(fields: [categoryId], references: [id])
  languages    QuestionLanguage[]
  media        QuestionMedia[]
  options      QuestionOption[]
  tags         QuestionTag[]
  testCases    TestCase[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([questionType])
  @@index([status])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  CODING
  MCQ
  SQL
  SUBJECTIVE
  FILE_UPLOAD
}
