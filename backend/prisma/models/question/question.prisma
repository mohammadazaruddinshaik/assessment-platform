model Question {
  id         String  @id @default(uuid())
  categoryId String?

  title       String
  description String
  constraints String?

  questionType QuestionType
  difficulty   Difficulty
  status       QuestionStatus

  languages    QuestionLanguage[]
  testCases    TestCase[]
  options      QuestionOption[]
  codingConfig CodingQuestionConfig?
  mcqConfig    MCQConfig?

  createdBy String
  updatedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category?       @relation(fields: [categoryId], references: [id])
  tags     QuestionTag[]
  media    QuestionMedia[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([questionType])
  @@index([status])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  CODING
  MCQ
  SQL
  SUBJECTIVE
  FILE_UPLOAD
}
