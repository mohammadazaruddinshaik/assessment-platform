model TestCaseMedia {
  id           String    @id @default(uuid())
  testCaseId   String
  type         MediaType
  url          String
  publicId     String?
  altText      String?
  displayOrder Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, displayOrder])
  @@index([testCaseId])
}
