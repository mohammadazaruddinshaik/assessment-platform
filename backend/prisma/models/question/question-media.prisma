model QuestionMedia {
  id           String    @id @default(uuid())
  questionId   String
  type         MediaType
  url          String
  publicId     String?
  altText      String?
  displayOrder Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, displayOrder])
  @@index([questionId])
}

enum MediaType {
  IMAGE
  GIF
}
