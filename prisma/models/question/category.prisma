model Category {
  id String @id @default(uuid())

  name        String
  description String?
  status      CategoryStatus

  createdBy String
  updatedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]

  @@unique([name])
  @@index([status])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}
